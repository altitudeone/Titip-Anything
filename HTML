<!DOCTYPE html>
<html>
<head>
  <base target="_top">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Titip Anything</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background: #f8f9fa; padding-bottom: 50px; }
    .watermark { position: fixed; bottom: 8px; right: 12px; font-size: 11px; color: #888; background: #fff; padding: 2px 8px; border-radius: 8px; pointer-events: none; }
  </style>
</head>
<body class="p-3 mx-auto" style="max-width: 480px;">

  <div class="text-center mb-3">
    <h5 class="fw-bold text-primary mb-1">🍔 Titip Anything</h5>
    <small class="text-muted">Sistem Titip Pesanan Praktis & Transparan</small>
  </div>

  <!-- Tab Buttons -->
  <ul class="nav nav-pills nav-justified mb-3">
    <li class="nav-item">
      <button class="nav-link active fw-bold" data-bs-toggle="pill" data-bs-target="#tab-form">Pesan Titipan</button>
    </li>
    <li class="nav-item">
      <button class="nav-link fw-bold" data-bs-toggle="pill" data-bs-target="#tab-list" onclick="loadPending()">Daftar Pesanan</button>
    </li>
  </ul>

  <div class="tab-content">
    <!-- Tab 1: Form Pesanan -->
    <div class="tab-pane fade show active" id="tab-form">
      <form class="card p-3 shadow-sm" onsubmit="submitForm(this); return false;">
        <div class="mb-2">
          <label class="form-label small fw-bold">Nama Pemesan</label>
          <input type="text" name="nama" class="form-control" placeholder="Contoh: Joan" required>
        </div>
        <div class="mb-2">
          <label class="form-label small fw-bold">Lantai / Ruangan</label>
          <input type="text" name="lantai" class="form-control" placeholder="Contoh: Lt 6 / R. Meeting">
        </div>
        <div class="mb-2">
          <label class="form-label small fw-bold">Detail Pesanan</label>
          <textarea name="pesanan" class="form-control" rows="2" placeholder="Contoh: Nasi padang pakai rendang" required></textarea>
        </div>
        <div class="mb-3">
          <label class="form-label small fw-bold">Metode Pembayaran</label>
          <select name="metodeBayar" class="form-select">
            <option value="Cash">Cash</option>
            <option value="QRIS">QRIS</option>
          </select>
        </div>
        <button id="btnSend" type="submit" class="btn btn-primary fw-bold w-100">Kirim Pesanan</button>
      </form>
    </div>

    <!-- Tab 2: Daftar Pesanan (Tempat Menampilkan Data) -->
    <div class="tab-pane fade" id="tab-list">
      <div id="loader" class="text-center my-4 d-none">
        <div class="spinner-border spinner-border-sm text-primary"></div> Memuat data pesanan...
      </div>
      <div id="container"></div>
    </div>
  </div>

  <div class="watermark">Crafted by: <strong>WaktuLuangProject</strong></div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function submitForm(f) {
      const b = document.getElementById('btnSend');
      b.disabled = true; b.innerText = 'Mengirim...';
      google.script.run.withSuccessHandler(r => {
        alert(r.message); f.reset(); b.disabled = false; b.innerText = 'Kirim Pesanan';
      }).tambahPesanan({ nama: f.nama.value, lantai: f.lantai.value, pesanan: f.pesanan.value, metodeBayar: f.metodeBayar.value });
    }

    function loadPending() {
      const c = document.getElementById('container'), l = document.getElementById('loader');
      c.innerHTML = ''; 
      l.classList.remove('d-none');

      google.script.run.withSuccessHandler(data => {
        l.classList.add('d-none');
        if (!data || data.length === 0) {
          c.innerHTML = '<div class="alert alert-secondary text-center small my-3">Belum ada pesanan pending 👍</div>';
          return;
        }
        let html = '';
        data.forEach(i => {
          html += `
            <div class="card p-3 mb-2 shadow-sm border-0">
              <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="fw-bold">${i.nama} <small class="text-muted">(${i.lantai || '-'})</small></span>
                <span class="badge bg-warning text-dark">${i.metodeBayar}</span>
              </div>
              <p class="text-secondary small mb-2">${i.pesanan}</p>
              <div class="row g-1 mb-2">
                <div class="col-6">
                  <input type="number" id="h_${i.rowNum}" class="form-control form-control-sm" placeholder="Harga Asli (Rp)">
                </div>
                <div class="col-6">
                  <input type="text" id="c_${i.rowNum}" class="form-control form-control-sm" placeholder="Catatan">
                </div>
              </div>
              <button class="btn btn-success btn-sm fw-bold w-100" onclick="done(${i.rowNum})">Selesai ✔</button>
            </div>`;
        });
        c.innerHTML = html;
      }).getPesananPending();
    }

    function done(id) {
      const h = document.getElementById(`h_${id}`).value, c = document.getElementById(`c_${id}`).value;
      if (!h || h <= 0) return alert('Isi nominal harga asli dulu bro!');
      google.script.run.withSuccessHandler(r => { 
        alert(r.message); 
        loadPending(); 
      }).selesaikanPesanan(id, h, c);
    }
  </script>
</body>
</html>
